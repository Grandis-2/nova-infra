# 로컬 설정. 복사해서 .env 로 쓴다 (.env 는 커밋하지 않는다): cp .env.example .env
#
# TF_VAR_* 는 넣지 않는다.
#   공통 값(product, env, 리전, 상태 버킷) → terraform/variables/global.auto.tfvars (커밋)
#   스택별 값                          → 각 스택의 terraform.tfvars (커밋)
#   비밀                               → sops 파일 · Terraform 생성
#   실행 역할(TF_VAR_assume_role_arn)  → Atlantis 에만 있다. 로컬은 비워 둔다
#
# scripts/tf.sh 와 bootstrap.sh 가 이 파일을 읽는다.
# 관리자 세션(환경변수 자격증명)이 열려 있으면 AWS_PROFILE 은 무시된다 (docs/bootstrap.md 4절).

# 평소에는 읽기 전용 역할로 plan · output 만 한다
AWS_PROFILE=nova-readonly
AWS_REGION=ap-northeast-2

# 상태 버킷. global.auto.tfvars 의 tfstate_bucket 과 같아야 한다
TF_BACKEND_BUCKET=grandis-nova-prod-apnortheast2-tfstate
TF_BACKEND_REGION=ap-northeast-2
