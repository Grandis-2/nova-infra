# Terraform 이 만드는 비밀 — application/<서비스>/service.yml 의 generated_secrets.
# ephemeral 로 만들어 쓰기 전용으로 넣으므로 값이 상태 파일에 남지 않는다.
# 처음 한 번만 쓰고, secret_versions 의 번호를 올릴 때만 새 값으로 바꾼다 (키 교체).
#
#   rsa-2048      RSA 2048 개인키 (PKCS#8 PEM)
#   random-48     무작위 48바이트 (base64)
#   admin-bcrypt  관리자 비밀번호의 bcrypt 해시. 원문은 nova-prod/ops/<서비스>/admin-password (서비스에는 주지 않는다)
#   shared/<이름> 공유 시크릿 nova-prod/shared/<이름> (무작위 48바이트). 같은 이름을 쓰는 서비스가 같은 값을 읽는다

locals {
  _gen_by_type = { for id, t in local.generated_secrets : id => t }
  _rsa         = { for id, t in local._gen_by_type : id => t if t == "rsa-2048" }
  _random      = { for id, t in local._gen_by_type : id => t if t == "random-48" }
  _admin       = { for id, t in local._gen_by_type : id => t if t == "admin-bcrypt" }

  # "<서비스>/<키>" -> 시크릿 이름의 서비스 부분
  _gen_service = { for id, t in local._gen_by_type : id => local.services[split("/", id)[0]].name }

  version_of = { for id in concat(keys(local._gen_by_type), [for n in local.shared_secrets : "shared/${n}"], [local.grafana_admin_version_key]) : id => lookup(var.secret_versions, id, 1) }
}

# secret_versions 에 오타 키가 있으면 아무 비밀도 바뀌지 않고 조용히 넘어간다. plan 을 멈춰 알린다.
# (변수 validation 에서 local.version_of 를 참조하면 순환 의존이 되므로 여기서 확인한다)
resource "terraform_data" "secret_versions_check" {
  lifecycle {
    precondition {
      condition     = length(setsubtract(keys(var.secret_versions), keys(local.version_of))) == 0
      error_message = "secret_versions 에 없는 비밀 키가 있습니다: ${join(", ", setsubtract(keys(var.secret_versions), keys(local.version_of)))}. 키는 \"<서비스>/<환경변수>\", \"shared/<이름>\" 또는 \"${local.grafana_admin_version_key}\" 입니다."
    }
  }
}

ephemeral "tls_private_key" "rsa" {
  for_each = local._rsa

  algorithm = "RSA"
  rsa_bits  = 2048
}

ephemeral "random_bytes" "random" {
  for_each = merge(local._random, { for n in local.shared_secrets : "shared/${n}" => n })

  length = 48
}

ephemeral "random_password" "admin" {
  for_each = local._admin

  length  = 24
  special = false
}

# ── 서비스별 생성 비밀 (키마다 시크릿 하나 — 하나를 바꿔도 다른 키는 그대로다) ──
resource "aws_secretsmanager_secret" "generated" {
  for_each = local._gen_by_type

  name                    = "${local.name_prefix}/app/${local._gen_service[each.key]}/${split("/", each.key)[1]}"
  description             = "Generated by Terraform (${each.value}) for ${local._gen_service[each.key]}"
  recovery_window_in_days = 7

  tags = { Service = local._gen_service[each.key] }
}

resource "aws_secretsmanager_secret_version" "generated" {
  for_each = local._gen_by_type

  secret_id = aws_secretsmanager_secret.generated[each.key].id
  secret_string_wo = (
    each.value == "rsa-2048" ? ephemeral.tls_private_key.rsa[each.key].private_key_pem_pkcs8 :
    each.value == "random-48" ? ephemeral.random_bytes.random[each.key].base64 :
    ephemeral.random_password.admin[each.key].bcrypt_hash
  )
  secret_string_wo_version = local.version_of[each.key]
}

# 관리자 비밀번호 원문 — 사람이 로그인할 때 쓴다. 서비스(실행 역할)에는 읽기 권한을 주지 않는다
resource "aws_secretsmanager_secret" "admin_password" {
  for_each = local._admin

  name                    = "${local.name_prefix}/ops/${local._gen_service[each.key]}/admin-password"
  description             = "Admin login password for ${local._gen_service[each.key]} (plaintext of the bcrypt hash)"
  recovery_window_in_days = 7

  tags = { Service = local._gen_service[each.key] }
}

resource "aws_secretsmanager_secret_version" "admin_password" {
  for_each = local._admin

  secret_id                = aws_secretsmanager_secret.admin_password[each.key].id
  secret_string_wo         = ephemeral.random_password.admin[each.key].result
  secret_string_wo_version = local.version_of[each.key] # 해시와 같은 번호 — 같이 바뀐다
}

# ── 공유 비밀 ───────────────────────────────────────────────
resource "aws_secretsmanager_secret" "shared" {
  for_each = local.shared_secrets

  name                    = "${local.name_prefix}/shared/${each.value}"
  description             = "Generated by Terraform. Shared by services that reference shared/${each.value}"
  recovery_window_in_days = 7
}

resource "aws_secretsmanager_secret_version" "shared" {
  for_each = local.shared_secrets

  secret_id                = aws_secretsmanager_secret.shared[each.value].id
  secret_string_wo         = ephemeral.random_bytes.random["shared/${each.value}"].base64
  secret_string_wo_version = local.version_of["shared/${each.value}"]
}
