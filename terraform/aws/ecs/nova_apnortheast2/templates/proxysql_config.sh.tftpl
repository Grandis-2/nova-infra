#!/bin/sh
# ProxySQL 설정 파일을 만든다 (proxysql.tf 의 config-init 컨테이너). 끝나면 내려가고, 성공해야 proxysql 이 뜬다.
# 값은 ECS 가 환경변수로 넣는다: WRITER(SSM 의 현재 쓰기 대상), 관리자 · 감시 · 앱 계정 비밀번호.
# 로컬 시험(scripts/db-migration/local/up.sh)과 같은 설정이다. 하나를 고치면 다른 쪽도 고친다.
set -eu
umask 077

# 쓰기 대상 하나만 ONLINE 이고 나머지는 OFFLINE_HARD 다. 값을 못 읽었거나 모르는 값이면 실패해서 proxysql 이 뜨지 않는다
case "$${WRITER:-}" in
  ncp) ncp_status=ONLINE rds_status=OFFLINE_HARD ;;
  rds) ncp_status=OFFLINE_HARD rds_status=ONLINE ;;
  *) echo "WRITER 가 ncp | rds 가 아니다: '$${WRITER:-}'" >&2; exit 1 ;;
esac

cat >/config/proxysql.cnf <<EOF
datadir="/var/lib/proxysql"
admin_variables=
{
  admin_credentials="admin:$${PROXYSQL_ADMIN_PASSWORD};radmin:$${PROXYSQL_ADMIN_PASSWORD}"
  mysql_ifaces="0.0.0.0:${admin_port}"
}
mysql_variables=
{
  threads=4
  max_connections=2048
  interfaces="0.0.0.0:3306"
  server_version="${server_version}"
  have_ssl=true
  default_authentication_plugin="caching_sha2_password"
  connect_timeout_server_max=30000
  auto_increment_delay_multiplex=0
  monitor_username="proxysql_mon"
  monitor_password="$${PROXYSQL_MON_PASSWORD}"
}
# hostgroup 은 쓰기 대상, hostgroup + 1 은 감시 전용(두 서버를 늘 ONLINE 으로 둬 ProxySQL 감시가 계속 접속 · ping 한다. 이 그룹을 쓰는
# 계정 · 규칙은 없다). 런북은 전환 전에 이 감시 기록으로 받을 서버에 닿는지 본다(scripts/db-migration/lib.sh px_reachable)
mysql_servers=
(
  { address="${ncp_address}", port=${ncp_port}, hostgroup=${hostgroup}, status="$${ncp_status}", use_ssl=1, max_connections=${server_max_connections}, comment="ncp" },
  { address="${rds_address}", port=${rds_port}, hostgroup=${hostgroup}, status="$${rds_status}", use_ssl=1, max_connections=${server_max_connections}, comment="rds" },
  { address="${ncp_address}", port=${ncp_port}, hostgroup=${hostgroup + 1}, status="ONLINE", use_ssl=1, max_connections=1, comment="ncp monitor only" },
  { address="${rds_address}", port=${rds_port}, hostgroup=${hostgroup + 1}, status="ONLINE", use_ssl=1, max_connections=1, comment="rds monitor only" }
)
mysql_query_rules=
(
  { rule_id=10, active=1, match_digest="^SELECT @@session\\\\.auto_increment_increment", multiplex=2, apply=0, comment="Connector/J connect-time variables" },
  { rule_id=11, active=1, match_digest="^SELECT @@session\\\\.transaction_read_only", multiplex=2, apply=0, comment="Connector/J read-only check" },
  { rule_id=12, active=1, match_digest="^SELECT @@character_set_database ?, ?@@sql_mode", multiplex=2, apply=0, comment="Hibernate startup query" }
)
mysql_users=
(
%{ for i, u in users ~}
  { username="${u.username}", password="$${${u.env}}", default_hostgroup=${hostgroup}, active=1 }%{ if i < length(users) - 1 },%{ endif }
%{ endfor ~}
)
EOF
echo "proxysql.cnf: writer=$${WRITER}, users=${length(users)}"
