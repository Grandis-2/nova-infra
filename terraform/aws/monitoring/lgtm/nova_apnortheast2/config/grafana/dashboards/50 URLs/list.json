      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "refId": "A",
          "expr": "sum by (http_request_method, http_route) (increase(http_server_request_duration_seconds_count{service_namespace=\"nova\", job=\"nova/$service\", http_route!~\"/actuator.*\", http_route!=\"/**\"}[$__interval]))",
          "legendFormat": "{{http_request_method}} {{http_route}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
