{
  "uid": "nova-url",
  "title": "nova · URL 목록",
  "description": "서비스 하나의 API 를 표로 보고, 아래 경로 행을 펼쳐 하나씩 본다",
  "tags": [
    "nova",
    "url"
  ],
  "editable": false,
  "schemaVersion": 39,
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "timezone": "browser",
  "links": [
    {
      "title": "nova 대시보드",
      "type": "dashboards",
      "tags": [
        "nova"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    },
    {
      "title": "URL 화면",
      "type": "dashboards",
      "tags": [
        "url"
      ],
      "asDropdown": false,
      "includeVars": true,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "서비스",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "mimir"
        },
        "query": {
          "query": "label_values(target_info{job=~\"nova/.+\"}, job)",
          "refId": "service"
        },
        "definition": "label_values(target_info{job=~\"nova/.+\"}, job)",
        "regex": "/^nova\\/(.+)$/",
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "route",
        "label": "경로",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "mimir"
        },
        "hide": 0,
        "query": {
          "query": "label_values(http_server_request_duration_seconds_count{service_namespace=\"nova\", job=\"nova/$service\", http_route!~\"/actuator.*\", http_route!=\"/**\"}, http_route)",
          "refId": "route"
        },
        "definition": "label_values(http_server_request_duration_seconds_count{service_namespace=\"nova\", job=\"nova/$service\", http_route!~\"/actuator.*\", http_route!=\"/**\"}, http_route)",
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "panels": [
    {
      "type": "status-history",
      "title": "API × 시간 (요청 수)",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "description": "행은 API, 칸은 시간 구간, 진할수록 요청이 많다. 장애 시각에 어떤 API 가 튀었는지, API 마다 언제 몰리는지 본다",
      "maxDataPoints": 72,
      "interval": "5m",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "continuous-blues"
          },
          "custom": {
            "fillOpacity": 90,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "auto",
        "rowHeight": 0.9,
        "colWidth": 0.95,
        "legend": {
          "showLegend": false
