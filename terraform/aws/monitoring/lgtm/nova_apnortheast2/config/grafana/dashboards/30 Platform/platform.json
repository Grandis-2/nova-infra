{
  "uid": "nova-platform",
  "title": "nova · ECS · ALB · CloudFront",
  "description": "AWS 관리형 실행 환경(CloudWatch). 서비스 안쪽(HTTP · JVM)은 서비스 상세 대시보드",
  "tags": [
    "nova",
    "platform"
  ],
  "editable": false,
  "schemaVersion": 39,
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "5m",
  "timezone": "browser",
  "links": [
    {
      "title": "nova 대시보드",
      "type": "dashboards",
      "tags": [
        "nova"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "cluster",
        "label": "클러스터",
        "type": "query",
        "datasource": {
          "type": "cloudwatch",
          "uid": "cloudwatch"
        },
        "refresh": 1,
        "sort": 1,
        "regex": "",
        "query": {
          "refId": "cluster",
          "queryType": "dimensionValues",
          "region": "default",
          "namespace": "ECS/ContainerInsights",
          "metricName": "RunningTaskCount",
          "dimensionKey": "ClusterName",
          "dimensionFilters": {}
        }
      },
      {
        "name": "lb",
        "label": "ALB",
        "type": "query",
        "datasource": {
          "type": "cloudwatch",
          "uid": "cloudwatch"
        },
        "refresh": 1,
        "sort": 1,
        "regex": "/^app\\/nova-prod-alb\\/.*/",
        "query": {
          "refId": "lb",
          "queryType": "dimensionValues",
          "region": "default",
          "namespace": "AWS/ApplicationELB",
          "metricName": "RequestCount",
          "dimensionKey": "LoadBalancer",
          "dimensionFilters": {}
        }
      }
    ]
  },
