{
  "uid": "nova-compute",
  "title": "nova · ECS · 컴퓨팅",
  "description": "nova-prod 클러스터의 서비스 · 태스크와 NAT · obs EC2. CloudWatch(AWS/ECS · AWS/EC2)와 앱 지표",
  "tags": [
    "nova",
    "platform"
  ],
  "editable": false,
  "schemaVersion": 39,
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "5m",
  "timezone": "browser",
  "links": [
    {
      "title": "nova 대시보드",
      "type": "dashboards",
      "tags": [
        "nova"
      ],
