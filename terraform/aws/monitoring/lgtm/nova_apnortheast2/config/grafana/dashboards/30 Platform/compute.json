  "templating": {
    "list": [
      {
        "name": "nat",
        "label": "NAT 인스턴스",
        "type": "query",
        "datasource": {
          "type": "cloudwatch",
          "uid": "cloudwatch"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "query": {
          "refId": "nat",
          "queryType": "ec2InstanceAttributes",
          "region": "default",
          "attributeName": "InstanceId",
          "ec2Filters": {
            "tag:Name": [
              "nova-prod-nat-*"
            ]
          }
        }
      },
      {
        "name": "obs",
        "label": "obs 인스턴스",
        "type": "query",
        "datasource": {
          "type": "cloudwatch",
          "uid": "cloudwatch"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "query": {
          "refId": "obs",
          "queryType": "ec2InstanceAttributes",
          "region": "default",
          "attributeName": "InstanceId",
          "ec2Filters": {
            "tag:Name": [
              "nova-prod-obs"
            ]
          }
        }
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "활성 태스크",
      "description": "nova-prod 클러스터 전체(obs · 게이트웨이 포함). AWS/ECS LiveTaskCount 로 센다(뜨는 중 · 내려가는 중 포함). 서비스가 원하는 수보다 모자라면 CloudWatch '태스크 0개' 경보와 ECS 이벤트 경보(배포 · 배치 실패, 컨테이너 종료)가 알린다",
      "datasource": {
        "type": "cloudwatch",
        "uid": "cloudwatch"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center"
      },
      "targets": [
        {
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "refId": "A",
          "queryMode": "Metrics",
          "region": "default",
          "id": "",
          "period": "300",
          "label": "태스크",
          "metricQueryType": 0,
          "metricEditorMode": 1,
          "expression": "SUM(SEARCH('{AWS/ECS,ClusterName,ServiceName} MetricName=\"LiveTaskCount\" ClusterName=\"nova-prod\"', 'Maximum', 300))",
          "statistic": "Average"
        }
      ],
      "id": 1,
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "새로 뜬 태스크 (기간 합)",
      "description": "선택한 기간에 처음 지표를 보낸 앱 태스크 수(배포 · 스케일 아웃 · 장애 재시작). 배포가 없는데 늘면 태스크가 죽고 다시 뜨는 중이다",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 5
              },
              {
                "color": "red",
                "value": 20
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "refId": "A",
          "expr": "sum(count_over_time((count by (job, instance) (target_info{job=~\"nova/.+\"}) unless count by (job, instance) (target_info{job=~\"nova/.+\"} offset 5m))[$__range:5m])) or vector(0)",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "id": 2,
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 0
      }
    },
