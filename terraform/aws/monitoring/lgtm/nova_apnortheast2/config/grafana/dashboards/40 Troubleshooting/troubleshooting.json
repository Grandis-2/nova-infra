    {
      "type": "timeseries",
      "title": "요청 처리 시간 구성",
      "description": "1초 동안 요청 처리에 쓴 시간을 어디서 썼는지 나눈다(Collector span metrics, 샘플링 전 모든 요청). DB · 외부 호출 · 메시징은 나가는 스팬의 시간 합, 자체는 서버 · 컨슈머 스팬 시간에서 그것을 뺀 값이다. 병렬 호출이 있으면 자체가 실제보다 작게 보인다. 경로 선택은 걸리지 않는다",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "refId": "A",
          "expr": "sum by (db_system) (rate(traces_spanmetrics_duration_seconds_sum{job=~\"nova/(${service:regex})\", span_kind=~\"SPAN_KIND_(CLIENT|PRODUCER)\", db_system!=\"\"}[$__rate_interval]))",
          "legendFormat": "DB · {{db_system}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "refId": "B",
          "expr": "sum(rate(traces_spanmetrics_duration_seconds_sum{job=~\"nova/(${service:regex})\", span_kind=~\"SPAN_KIND_(CLIENT|PRODUCER)\", db_system=\"\", messaging_system=\"\"}[$__rate_interval]))",
          "legendFormat": "외부 호출"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "refId": "C",
          "expr": "sum(rate(traces_spanmetrics_duration_seconds_sum{job=~\"nova/(${service:regex})\", span_kind=~\"SPAN_KIND_(CLIENT|PRODUCER)\", messaging_system!=\"\"}[$__rate_interval]))",
          "legendFormat": "메시징"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "refId": "D",
          "expr": "clamp_min(sum(rate(traces_spanmetrics_duration_seconds_sum{job=~\"nova/(${service:regex})\", span_kind=~\"SPAN_KIND_(SERVER|CONSUMER)\"}[$__rate_interval])) - (sum(rate(traces_spanmetrics_duration_seconds_sum{job=~\"nova/(${service:regex})\", span_kind=~\"SPAN_KIND_(CLIENT|PRODUCER)\"}[$__rate_interval])) or vector(0)), 0)",
          "legendFormat": "자체 (코드 · 대기)"
        }
      ],
