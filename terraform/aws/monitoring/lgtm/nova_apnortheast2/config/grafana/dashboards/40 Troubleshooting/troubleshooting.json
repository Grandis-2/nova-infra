      },
      "description": "고른 경로의 요청 안에서 실행된 JDBC 스팬. 쿼리문의 값은 에이전트가 ? 로 바꿔 보낸다. 같은 쿼리가 여럿이면 MySQL 대시보드의 상위 SQL · 잠금을 본다",
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "A",
          "queryType": "traceql",
          "limit": 50,
          "tableType": "spans",
          "spss": 5,
          "query": "{resource.service.namespace=\"nova\" && resource.service.name=~\"${service:regex}\" && kind=server && span.http.route=~\"$route\"} >> {span.db.system=\"mysql\" && duration > $slowdb} | select(span.db.operation, span.db.sql.table, span.db.statement)"
        }
      ],
      "id": 16,
      "gridPos": {
