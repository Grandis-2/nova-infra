    {
      "type": "table",
      "title": "느린 요청 ($slow 초과, 서버 스팬)",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "A",
          "queryType": "traceql",
          "limit": 50,
          "tableType": "traces",
          "query": "{resource.service.namespace=\"nova\" && resource.service.name=~\"${service:regex}\" && kind=server && duration > $slow}"
        }
      ],
      "id": 6,
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 14
      }
    },
    {
      "type": "table",
      "title": "오류 (status=error)",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "A",
          "queryType": "traceql",
          "limit": 50,
          "tableType": "traces",
          "query": "{resource.service.namespace=\"nova\" && resource.service.name=~\"${service:regex}\" && status=error}"
        }
      ],
      "id": 7,
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 14
      }
    },
    {
      "type": "table",
      "title": "느린 DB 쿼리 ($slowdb 초과)",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "description": "JDBC 스팬. 쿼리문의 값은 에이전트가 ? 로 바꿔 보낸다. 같은 쿼리가 여럿이면 인덱스 · 잠금 대기를 의심한다",
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "A",
          "queryType": "traceql",
          "limit": 50,
          "tableType": "spans",
          "spss": 5,
          "query": "{resource.service.namespace=\"nova\" && resource.service.name=~\"${service:regex}\" && span.db.system=\"mysql\" && duration > $slowdb} | select(span.db.operation, span.db.sql.table, span.db.statement)"
        }
      ],
      "id": 8,
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 24
      }
