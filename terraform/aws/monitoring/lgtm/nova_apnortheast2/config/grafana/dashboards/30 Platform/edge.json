    {
      "type": "timeseries",
      "title": "CloudFront 응답 시간",
      "description": "사용자가 요청을 보내고 응답을 다 받기까지(CloudFront time-taken). 접근 로그라 몇 분 늦게 그려진다",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "quantile_over_time(0.5, {service_name=\"cloudfront\"} | unwrap aws_cloudfront_time_taken | __error__=\"\" [$__auto]) by ()",
          "legendFormat": "p50"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "B",
          "expr": "quantile_over_time(0.95, {service_name=\"cloudfront\"} | unwrap aws_cloudfront_time_taken | __error__=\"\" [$__auto]) by ()",
          "legendFormat": "p95"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "C",
          "expr": "quantile_over_time(0.99, {service_name=\"cloudfront\"} | unwrap aws_cloudfront_time_taken | __error__=\"\" [$__auto]) by ()",
          "legendFormat": "p99"
        }
      ],
      "id": 9,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 18
      },
      "interval": "5m"
    },
