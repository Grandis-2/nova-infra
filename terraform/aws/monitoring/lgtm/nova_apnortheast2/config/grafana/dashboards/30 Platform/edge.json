{
  "uid": "nova-edge",
  "title": "nova · 엣지 · 보안",
  "description": "사용자 요청이 들어오는 길: CloudFront → WAF → ALB, 그리고 인증서. CloudWatch(CloudFront · WAF 는 us-east-1)",
  "tags": [
    "nova",
    "platform"
  ],
  "editable": false,
  "schemaVersion": 39,
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "5m",
  "timezone": "browser",
  "links": [
    {
      "title": "nova 대시보드",
      "type": "dashboards",
      "tags": [
        "nova"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "dist",
        "label": "CloudFront",
        "type": "query",
        "datasource": {
          "type": "cloudwatch",
          "uid": "cloudwatch"
        },
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "regex": "/distribution\\/(.+)$/",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "query": {
          "refId": "dist",
          "queryType": "resourceARNs",
          "region": "us-east-1",
          "resourceType": "cloudfront:distribution",
          "tags": {
            "Product": [
              "nova"
            ]
          }
        }
      },
      {
        "name": "lb",
        "label": "ALB",
        "type": "query",
        "datasource": {
          "type": "cloudwatch",
          "uid": "cloudwatch"
        },
        "refresh": 1,
        "sort": 1,
        "regex": "/^app\\/nova-prod-alb\\/.*/",
        "query": {
          "refId": "lb",
          "queryType": "dimensionValues",
          "region": "default",
          "namespace": "AWS/ApplicationELB",
          "metricName": "RequestCount",
          "dimensionKey": "LoadBalancer",
          "dimensionFilters": {}
        }
      }
    ]
  },
