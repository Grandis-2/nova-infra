        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "refId": "E",
          "expr": "max by (service) (label_replace(sum by (job, instance) (jvm_memory_used_bytes{service_namespace=\"nova\", jvm_memory_type=\"heap\"}) / sum by (job, instance) (jvm_memory_limit_bytes{service_namespace=\"nova\", jvm_memory_type=\"heap\"}), \"service\", \"$1\", \"job\", \"nova/(.+)\"))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "refId": "F",
          "expr": "max by (service) (label_replace(jvm_cpu_recent_utilization_ratio{service_namespace=\"nova\"}, \"service\", \"$1\", \"job\", \"nova/(.+)\"))",
          "legendFormat": "",
          "instant": true,
