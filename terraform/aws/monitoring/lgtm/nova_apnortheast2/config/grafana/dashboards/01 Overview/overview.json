{
  "uid": "nova-overview",
  "title": "nova · 개요",
  "description": "서비스 전체 현황. 이상이 보이면 서비스 상세 → 트러블슈팅 순으로 내려간다",
  "tags": [
    "nova",
    "overview"
  ],
  "editable": false,
  "schemaVersion": 39,
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "timezone": "browser",
  "links": [
    {
      "title": "nova 대시보드",
      "type": "dashboards",
      "tags": [
        "nova"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "stat",
      "title": "요청 수",
      "description": "헬스체크(/actuator) 제외. 모든 서비스 합",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "refId": "A",
          "expr": "sum(rate(http_server_request_duration_seconds_count{service_namespace=\"nova\", http_route!~\"/actuator.*\"}[$__rate_interval]))",
          "legendFormat": ""
        }
      ],
      "id": 1,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
