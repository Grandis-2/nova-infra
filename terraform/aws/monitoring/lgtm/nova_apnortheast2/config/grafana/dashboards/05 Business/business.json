      "type": "timeseries",
      "title": "신규 예약 (결과별)",
      "description": "분당 예약 요청 수를 결과로 나눈다. success = 새 예약, rejected = 업무 거절(재고 · 중복 · 회차 상태), error = 처리 실패(5xx)",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "refId": "A",
          "expr": "sum by (result) (rate(nova_preorder_created_total[$__rate_interval])) * 60",
          "legendFormat": "{{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "custom": {
            "drawStyle": "line",
