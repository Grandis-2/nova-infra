    {
      "id": 4,
      "type": "stat",
      "title": "접수 상태 (최근 20분)",
      "description": "접수 중인 회차가 있는데 최근 20분 동안 일반 회원 신규 예약이 0건이면 \"멈춤 의심\" 으로 표시한다. 새벽처럼 원래 사람이 없는 시간에도 그렇게 보일 수 있어 경보는 보내지 않는다",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 3
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "refId": "A",
          "expr": "(max(nova_preorder_campaigns_accepting) > bool 0) * ((sum(increase(nova_preorder_created_total{result=\"success\",channel=\"user\"}[20m])) or vector(0)) == bool 0)",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "정상",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "멈춤 의심",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
