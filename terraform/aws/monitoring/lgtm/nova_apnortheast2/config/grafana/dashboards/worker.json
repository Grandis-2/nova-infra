{
  "uid": "nova-worker",
  "title": "nova · worker",
  "tags": [
    "nova",
    "service"
  ],
  "editable": false,
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "timezone": "browser",
  "panels": [
    {
      "type": "row",
      "title": "HTTP (에이전트 지표)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": [],
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "요청 수",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "refId": "A",
          "expr": "sum by (http_route) (rate(http_server_request_duration_seconds_count{job=\"nova/worker\"}[$__rate_interval]))",
          "legendFormat": "{{http_route}}",
          "exemplar": true
        }
      ],
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "오류율 (5xx)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "refId": "A",
          "expr": "sum(rate(http_server_request_duration_seconds_count{job=\"nova/worker\", http_response_status_code=~\"5..\"}[$__rate_interval])) / sum(rate(http_server_request_duration_seconds_count{job=\"nova/worker\"}[$__rate_interval]))",
          "legendFormat": "5xx",
          "exemplar": true
        }
      ],
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "P99 응답 시간",
      "description": "점(exemplar)을 누르면 그 요청의 트레이스로 간다",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le, http_route) (rate(http_server_request_duration_seconds_bucket{job=\"nova/worker\"}[$__rate_interval])))",
          "legendFormat": "{{http_route}}",
          "exemplar": true
        }
      ],
      "id": 4
    },
    {
      "type": "row",
      "title": "JVM",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "panels": [],
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "힙",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "refId": "A",
          "expr": "sum by (instance) (jvm_memory_used_bytes{job=\"nova/worker\", jvm_memory_type=\"heap\"})",
          "legendFormat": "사용 {{instance}}",
          "exemplar": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "refId": "B",
          "expr": "sum by (instance) (jvm_memory_limit_bytes{job=\"nova/worker\", jvm_memory_type=\"heap\"})",
          "legendFormat": "한도 {{instance}}",
          "exemplar": true
        }
      ],
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "GC 시간 비율",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "refId": "A",
          "expr": "sum by (instance) (rate(jvm_gc_duration_seconds_sum{job=\"nova/worker\"}[$__rate_interval]))",
          "legendFormat": "{{instance}}",
          "exemplar": true
        }
      ],
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "스레드",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "refId": "A",
          "expr": "sum by (instance) (jvm_thread_count{job=\"nova/worker\"})",
          "legendFormat": "{{instance}}",
          "exemplar": true
        }
      ],
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "CPU",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "refId": "A",
          "expr": "avg by (instance) (jvm_cpu_recent_utilization_ratio{job=\"nova/worker\"})",
          "legendFormat": "{{instance}}",
          "exemplar": true
        }
      ],
      "id": 9
    },
    {
      "type": "row",
      "title": "DB 커넥션 풀",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "panels": [],
      "id": 10
    },
    {
      "type": "timeseries",
      "title": "커넥션 (상태별)",
      "description": "HikariCP. 이름이 semconv 단계에 따라 달라 두 이름을 같이 본다",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 19
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "refId": "A",
          "expr": "sum by (state) (db_client_connections_usage{job=\"nova/worker\"} or db_client_connection_count{job=\"nova/worker\"})",
          "legendFormat": "{{state}}",
          "exemplar": true
        }
      ],
      "id": 11
    },
    {
      "type": "timeseries",
      "title": "커넥션 대기 (P99)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 19
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(db_client_connections_wait_time_seconds_bucket{job=\"nova/worker\"}[$__rate_interval]) or rate(db_client_connection_wait_time_seconds_bucket{job=\"nova/worker\"}[$__rate_interval])))",
          "legendFormat": "P99",
          "exemplar": true
        }
      ],
      "id": 12
    },
    {
      "type": "row",
      "title": "로그 · 트레이스",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 27
      },
      "panels": [],
      "id": 13
    },
    {
      "type": "logs",
      "title": "WARN · ERROR 로그",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "{service_name=\"worker\", service_namespace=\"nova\"} | severity_text=~\"WARN|ERROR\""
        }
      ],
      "id": 14
    },
    {
      "type": "table",
      "title": "오류 트레이스",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "A",
          "queryType": "traceql",
          "limit": 20,
          "query": "{resource.service.name=\"worker\" && resource.service.namespace=\"nova\" && status=error}"
        }
      ],
      "id": 15
    }
  ]
}
