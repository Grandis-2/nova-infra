      "description": "오류가 난 트레이스는 샘플링 없이 남는다. 보낸 쪽 요청부터 처리까지 한 트레이스로 이어진다",
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "A",
          "queryType": "traceql",
          "limit": 20,
          "tableType": "traces",
          "query": "{kind=consumer && status=error && span.messaging.system=\"aws_sqs\"}"
        }
      ],
      "id": 6,
