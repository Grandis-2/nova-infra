{
  "uid": "nova-sqs",
  "title": "nova · SQS · 비동기 흐름",
  "description": "보내고 처리하는 흐름(트레이스)과 큐 상태(CloudWatch). DLQ 는 맨 아래에 따로 모은다",
  "tags": [
    "nova",
    "data"
  ],
  "editable": false,
  "schemaVersion": 39,
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "5m",
  "timezone": "browser",
  "links": [
    {
      "title": "nova 대시보드",
      "type": "dashboards",
      "tags": [
        "nova"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "queue",
        "label": "큐",
        "type": "query",
        "datasource": {
          "type": "cloudwatch",
          "uid": "cloudwatch"
        },
        "refresh": 1,
        "sort": 1,
        "regex": "/^(?!.*-dlq$).*$/",
        "query": {
          "refId": "queue",
          "queryType": "dimensionValues",
          "region": "default",
          "namespace": "AWS/SQS",
          "metricName": "ApproximateNumberOfMessagesVisible",
          "dimensionKey": "QueueName",
          "dimensionFilters": {}
        },
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "메시지 흐름 (트레이스)",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "table",
      "title": "큐 · 서비스 (선택한 기간)",
      "description": "어느 서비스가 보내고 어느 서비스가 처리하는지. 보내는 쪽만 있고 처리하는 쪽이 없으면 그 기간에 처리가 없었거나 처리 쪽 계측이 빠진 것이다",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "초당"
            },
            "properties": [
              {
                "id": "unit",
                "value": "reqps"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "역할"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "SPAN_KIND_PRODUCER": {
                        "text": "보냄"
                      },
                      "SPAN_KIND_CONSUMER": {
                        "text": "처리"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "초당",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "queue": "큐",
              "service_name": "서비스",
              "span_kind": "역할",
              "Value": "초당"
            }
          }
        }
      ],
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "refId": "A",
          "expr": "sum by (queue, service_name, span_kind) (label_replace(rate(traces_spanmetrics_calls_total{messaging_system!=\"\", span_name=~\"(${queue:regex}) (publish|process)\"}[$__range]), \"queue\", \"$1\", \"span_name\", \"(.+) (publish|process)\"))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "id": 2,
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 0,
        "y": 1
      }
    },
    {
      "type": "timeseries",
      "title": "보냄 · 처리 (초당)",
      "description": "보냄이 처리보다 계속 많으면 큐가 쌓인다(아래 적체 · 가장 오래된 메시지 나이)",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "refId": "A",
          "expr": "sum by (queue) (label_replace(rate(traces_spanmetrics_calls_total{messaging_system!=\"\", span_name=~\"(${queue:regex}) (publish|process)\", span_kind=\"SPAN_KIND_PRODUCER\"}[$__rate_interval]), \"queue\", \"$1\", \"span_name\", \"(.+) (publish|process)\"))",
          "legendFormat": "{{queue}} 보냄"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "refId": "B",
          "expr": "sum by (queue) (label_replace(rate(traces_spanmetrics_calls_total{messaging_system!=\"\", span_name=~\"(${queue:regex}) (publish|process)\", span_kind=\"SPAN_KIND_CONSUMER\"}[$__rate_interval]), \"queue\", \"$1\", \"span_name\", \"(.+) (publish|process)\"))",
          "legendFormat": "{{queue}} 처리"
        }
      ],
      "id": 3,
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 8,
        "y": 1
      }
    },
    {
      "type": "timeseries",
      "title": "처리 오류율",
      "description": "처리 스팬이 오류로 끝난 비율. 실패한 메시지는 가시성 시간 뒤 다시 처리되고, 횟수를 다 쓰면 DLQ 로 간다. 경보: 메시지 처리 오류율",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "refId": "A",
          "expr": "(sum by (queue) (label_replace(rate(traces_spanmetrics_calls_total{messaging_system!=\"\", span_name=~\"(${queue:regex}) (publish|process)\", span_kind=\"SPAN_KIND_CONSUMER\", status_code=\"STATUS_CODE_ERROR\"}[$__rate_interval]), \"queue\", \"$1\", \"span_name\", \"(.+) (publish|process)\")) or 0 * sum by (queue) (label_replace(rate(traces_spanmetrics_calls_total{messaging_system!=\"\", span_name=~\"(${queue:regex}) (publish|process)\", span_kind=\"SPAN_KIND_CONSUMER\"}[$__rate_interval]), \"queue\", \"$1\", \"span_name\", \"(.+) (publish|process)\"))) / sum by (queue) (label_replace(rate(traces_spanmetrics_calls_total{messaging_system!=\"\", span_name=~\"(${queue:regex}) (publish|process)\", span_kind=\"SPAN_KIND_CONSUMER\"}[$__rate_interval]), \"queue\", \"$1\", \"span_name\", \"(.+) (publish|process)\"))",
          "legendFormat": "{{queue}}"
        }
      ],
      "id": 4,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 10
      }
    },
    {
      "type": "timeseries",
      "title": "처리 시간 p99",
      "description": "메시지 하나를 처리하는 데 걸린 시간(처리 스팬). 큐에서 기다린 시간은 아래 가장 오래된 메시지 나이",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le, queue) (label_replace(rate(traces_spanmetrics_duration_seconds_bucket{messaging_system!=\"\", span_name=~\"(${queue:regex}) (publish|process)\", span_kind=\"SPAN_KIND_CONSUMER\"}[$__rate_interval]), \"queue\", \"$1\", \"span_name\", \"(.+) (publish|process)\")))",
          "legendFormat": "{{queue}}"
        }
      ],
      "id": 5,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 10
      }
