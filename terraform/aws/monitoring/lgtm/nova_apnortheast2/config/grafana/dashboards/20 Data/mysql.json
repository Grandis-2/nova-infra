{
  "uid": "nova-mysql",
  "title": "nova · MySQL (NCP)",
  "description": "NCP Cloud DB for MySQL. obs 태스크의 mysqld_exporter(READ 계정)가 SHOW GLOBAL STATUS · VARIABLES 를 읽는다",
  "tags": [
    "nova",
    "data"
  ],
  "editable": false,
  "schemaVersion": 39,
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "timezone": "browser",
  "links": [
    {
      "title": "nova 대시보드",
      "type": "dashboards",
      "tags": [
        "nova"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "stat",
      "title": "exporter 연결",
      "description": "1 이면 obs 의 mysqld_exporter 가 DB 에 붙어 있다. 0 이면 아래 지표가 모두 멈춘다",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "끊김"
                },
                "1": {
                  "text": "정상"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "refId": "A",
          "expr": "mysql_up{job=\"mysqld\"}",
          "legendFormat": ""
        }
      ],
      "id": 1,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "연결 사용률",
      "description": "현재 연결 / max_connections. 서비스 태스크 수 × Hikari 풀(maximum-pool-size)이 여기로 모인다",
