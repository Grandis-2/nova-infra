    {
      "type": "timeseries",
      "title": "이 URL 의 시간 구성 (트레이스 표본)",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "description": "이 URL 요청 안에서 나가는 호출(DB · 외부 HTTP · 큐)에 쓴 시간과 서버 스팬 전체 시간. db_system 이 비면 DB 가 아닌 호출이다. Tempo 에 남은 트레이스로 세므로 오류 · 1초 초과 요청 쪽으로 기운다. 비율 · 모양을 보고 정확한 수는 위 지표로 본다",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "fillOpacity": 15,
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "sum_over_time"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "서버 스팬 전체"
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "A",
          "queryType": "traceql",
          "metricsQueryType": "range",
          "query": "{resource.service.namespace=\"nova\" && resource.service.name=~\"${service:regex}\" && kind=server && span.http.request.method=~\"$method\" && span.http.route=~`${route:regex}`} >> {kind=client} | sum_over_time(duration) by (span.db.system)"
        },
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "B",
          "queryType": "traceql",
          "metricsQueryType": "range",
          "query": "{resource.service.namespace=\"nova\" && resource.service.name=~\"${service:regex}\" && kind=server && span.http.request.method=~\"$method\" && span.http.route=~`${route:regex}`} | sum_over_time(duration)"
