    {
      "type": "table",
      "title": "시간대별 요청 (최근 14일, KST)",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "description": "열은 날짜, 행은 시각(한국 시간). 칸 하나가 그 날 그 시각 한 시간 동안의 요청 수이고 진할수록 많다. 매일 몰리는 시간대 · 요일을 본다. 지금 시각의 칸은 진행 중인 한 시간이라 지금까지의 수다",
      "timeFrom": "now-13d/d",
      "interval": "1h",
      "maxDataPoints": 360,
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "min": 0,
          "noValue": "",
          "color": {
            "mode": "continuous-blues"
          },
          "custom": {
            "align": "center",
            "minWidth": 44,
            "cellOptions": {
              "type": "color-background",
              "mode": "basic"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "시"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto"
                }
              },
              {
                "id": "custom.width",
                "value": 48
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "transformations": [
        {
          "id": "formatTime",
          "options": {
            "timeField": "Time",
            "outputFormat": "MM/DD ddd|HH",
            "timezone": "Asia/Seoul"
          }
        },
        {
          "id": "extractFields",
          "options": {
            "source": "Time",
            "format": "regexp",
            "regExp": "/(?<날짜>.+)\\|(?<시각>\\d\\d)$/",
            "replace": false
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "시각",
                "desc": false
              }
            ]
          }
        },
        {
          "id": "calculateField",
          "options": {
            "mode": "binary",
            "alias": "건수",
            "replaceFields": false,
            "binary": {
              "left": {
                "matcher": {
                  "id": "byName",
                  "options": "요청"
                }
              },
              "operator": "*",
              "right": {
                "fixed": "1"
              }
            }
          }
        },
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "날짜",
            "rowField": "시각",
            "valueField": "건수"
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "시각\\날짜": "시"
            }
          }
