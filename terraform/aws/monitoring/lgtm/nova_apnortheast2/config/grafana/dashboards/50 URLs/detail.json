        "query": {
          "query": "label_values(http_server_request_duration_seconds_count{service_namespace=\"nova\", job=~\"nova/(${service:regex})\", http_route!~\"/actuator.*\", http_route!=\"/**\", http_request_method=~\"$method\"}, http_route)",
          "refId": "route"
        },
        "definition": "label_values(http_server_request_duration_seconds_count{service_namespace=\"nova\", job=~\"nova/(${service:regex})\", http_route!~\"/actuator.*\", http_route!=\"/**\", http_request_method=~\"$method\"}, http_route)",
