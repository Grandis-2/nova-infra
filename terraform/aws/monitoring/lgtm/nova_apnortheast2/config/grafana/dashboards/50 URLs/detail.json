  "templating": {
    "list": [
      {
        "name": "service",
        "label": "서비스",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "mimir"
        },
        "query": {
          "query": "label_values(target_info{job=~\"nova/.+\"}, job)",
          "refId": "service"
        },
        "definition": "label_values(target_info{job=~\"nova/.+\"}, job)",
        "regex": "/^nova\\/(.+)$/",
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "method",
        "label": "메서드",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "mimir"
        },
        "query": {
          "query": "label_values(http_server_request_duration_seconds_count{service_namespace=\"nova\", job=~\"nova/(${service:regex})\", http_route!~\"/actuator.*\", http_route!=\"/**\"}, http_request_method)",
          "refId": "method"
        },
        "definition": "label_values(http_server_request_duration_seconds_count{service_namespace=\"nova\", job=~\"nova/(${service:regex})\", http_route!~\"/actuator.*\", http_route!=\"/**\"}, http_request_method)",
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "refresh": 2,
        "sort": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "route",
